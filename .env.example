# ---------------------------------------------------------------------------
# LIVE Response - environment template            (Block 1, Person 1)
#
# Copy to .env.local and fill in. NEVER commit .env.local.
# Anything prefixed NEXT_PUBLIC_ is shipped to the browser - treat it as public.
# Every variable below is documented in docs/MIDDLEWARE_SETUP.md.
# ---------------------------------------------------------------------------

# --- Supabase (Project settings -> API) ------------------------------------
# Already used by lib/supabase.ts and lib/supabase-server.ts. Do not rename.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
# SERVER ONLY. Bypasses RLS. Never expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# --- JWT signing (middleware team owns these) ------------------------------
# Generate: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ISSUER=live-response-api
JWT_AUDIENCE=live-response-web
# Access token lifetime in seconds (900 = 15 minutes).
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token lifetime in seconds (604800 = 7 days).
REFRESH_TOKEN_TTL_SECONDS=604800

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
# debug | info | warn | error
LOG_LEVEL=debug
# Set to 1 to allow non-HTTPS cookies during local / ngrok testing.
# Ignored in production.
ALLOW_INSECURE_COOKIES=1

# --- Emergency routing -----------------------------------------------------
# A new request is auto-routed to the nearest active hospital / emergency
# response organisation that has coordinates. If the closest one is further
# than this, the request is left UNROUTED for a dispatcher to triage rather
# than silently sent somewhere useless. Kilometres. Default 150.
ROUTING_MAX_RADIUS_KM=150

# --- Rate limiting ---------------------------------------------------------
# Set to 0 to disable while load-testing. Default is on.
RATE_LIMIT_ENABLED=1

# --- Mapping (browser) -----------------------------------------------------
# The prototype uses key-free OpenStreetMap embeds and route links.
NEXT_PUBLIC_MAP_PROVIDER=osm
NEXT_PUBLIC_ROUTE_LINK_PROVIDER=google

# --- Live tracking tuning (browser) ----------------------------------------
NEXT_PUBLIC_TRACKING_MIN_INTERVAL_MS=8000
NEXT_PUBLIC_TRACKING_MIN_DISTANCE_M=15
NEXT_PUBLIC_POLL_INTERVAL_MS=5000

  "item": [
    {
      "name": "01 - Authentication",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Test 1: Check if registration was successful\r",
                  "pm.test(\"Registration successful (200 or 201)\", function () {\r",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);\r",
                  "});\r",
                  "\r",
                  "// Test 2: Check if user data is returned\r",
                  "pm.test(\"Response contains user data\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData).to.have.property('user');\r",
                  "    pm.expect(jsonData.user).to.have.property('id');\r",
                  "    pm.expect(jsonData.user).to.have.property('email');\r",
                  "});\r",
                  "\r",
                  "// Test 3: Check if email is correct\r",
                  "pm.test(\"Email is correct\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.user.email).to.equal('testuser123@example.com');\r",
                  "});\r",
                  "\r",
                  "// Test 4: Check for duplicate email error\r",
                  "pm.test(\"Duplicate email returns 409\", function () {\r",
                  "    if (pm.response.code === 409) {\r",
                  "        const jsonData = pm.response.json();\r",
                  "        pm.expect(jsonData).to.have.property('error');\r",
                  "        pm.expect(jsonData.error).to.include('already exists');\r",
                  "    }\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"email\": \"testuser123@example.com\",\r\n  \"phone\": \"+27721234567\",\r\n  \"password\": \"Test@123456\",\r\n  \"display_name\": \"Test User\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Test 1: Check if login was successful\r",
                  "pm.test(\"Login successful (200)\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// Test 2: Check if token exists\r",
                  "pm.test(\"Response contains token\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData).to.have.property('token');\r",
                  "    pm.expect(jsonData.token).to.not.be.empty;\r",
                  "});\r",
                  "\r",
                  "// Test 3: Check if user data is included\r",
                  "pm.test(\"Response contains user data\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData).to.have.property('user');\r",
                  "    pm.expect(jsonData.user).to.have.property('id');\r",
                  "    pm.expect(jsonData.user).to.have.property('email');\r",
                  "});\r",
                  "\r",
                  "// Test 4: Save the token for future requests\r",
                  "if (pm.response.code === 200) {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.environment.set('token', jsonData.token);\r",
                  "    console.log(\"✅ Token saved successfully!\");\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"email\": \"testuser123@example.com\",\r\n  \"password\": \"Test@123456\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 - Emergency Requests",
      "item": [
        {
          "name": "Create Emergency Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Test 1: Check if request was created\r",
                  "pm.test(\"Request created (201)\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "// Test 2: Check if reference code exists\r",
                  "pm.test(\"Has reference code\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData).to.have.property('reference_code');\r",
                  "    pm.expect(jsonData.reference_code).to.match(/^[A-Z0-9]{8}$/);\r",
                  "});\r",
                  "\r",
                  "// Test 3: Check if status is submitted\r",
                  "pm.test(\"Status is submitted\", function () {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData).to.have.property('current_status', 'submitted');\r",
                  "});\r",
                  "\r",
                  "// Test 4: Save the request ID\r",
                  "if (pm.response.code === 201) {\r",
                  "    const jsonData = pm.response.json();\r",
                  "    pm.environment.set('request_id', jsonData.id);\r",
                  "    console.log(\"✅ Request ID saved: \" + jsonData.id);\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer ",
                "description": "{{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"category\": \"medical\",\r\n  \"severity\": \"high\",\r\n  \"note\": \"Patient is having trouble breathing\",\r\n  \"callback_number\": \"+27721234567\",\r\n  \"location\": {\r\n    \"latitude\": -26.2041,\r\n    \"longitude\": 28.0473,\r\n    \"accuracy_meters\": 15,\r\n    \"address_text\": \"123 Main Street, Johannesburg\"\r\n  }\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/emergency-requests",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "emergency-requests"
              ]
            }
          },
          "response": []
        },
        {
          "name": "List Requests",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
